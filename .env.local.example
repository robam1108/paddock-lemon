# Supabase 프로젝트에서 복사해 오세요.
#
# NEXT_PUBLIC_SUPABASE_URL
#   대시보드 상단 [Connect] 버튼 > App Frameworks 탭에 표시됩니다.
#   또는 브라우저 주소창의 프로젝트 ID 로 직접 조합해도 됩니다:
#   https://supabase.com/dashboard/project/<프로젝트ID>  ->  https://<프로젝트ID>.supabase.co
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Project Settings > API Keys 의 "Publishable key" (sb_publishable_... 로 시작).
#   구버전 프로젝트라면 "anon public" (eyJhbGci... 로 시작) 을 넣으면 됩니다. 둘 다 동작합니다.
#   ! Secret key (sb_secret_...) / service_role 키는 절대 여기에 넣지 마세요.
#     브라우저로 노출되어 RLS 가 무력화됩니다.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
